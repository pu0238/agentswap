# ── Demo agent (demo/agent.ts) ─ copy to .env ─────────────────────────────
# Throwaway Solana wallet that plays "the agent". Needs ~$2 USDC + ~0.01 SOL on mainnet.
# Base58 secret key (Phantom/Solflare export) OR JSON byte array from `solana-keygen` (e.g. [12,34,...]).
AGENT_SECRET_KEY=

# AgentSwap API the agent talks to (local wrangler dev or your *.workers.dev URL).
AGENTSWAP_URL=http://localhost:8787

# Solana mainnet RPC used to send the swap. Public one works but is rate limited;
# a free Helius/QuickNode/Triton URL is more reliable for a live demo.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
