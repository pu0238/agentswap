# Copy to .env in your PUBLIC CLIENT checkout; never use this in MCP settings.
AGENTSWAP_API=https://agentswap.forge-3.workers.dev
# 64-byte Solana secret: base58 OR JSON byte array. Execution requires SOL for source fees.
AGENT_SECRET_KEY=
# Optional for Solana-only payments; required for EVM x402 payments. 0x + 64 hex characters.
AGENT_EVM_PRIVATE_KEY=
AGENT_FROM=USDC
# Reuse the SAME order ID for retries; use a new ID only for a new purchase.
# AGENT_PAYMENT_INTENT_ID=order-42
AGENT_SLIPPAGE_BPS=50
# Optional: base, arbitrum, polygon, avalanche, sei, xlayer, solana
# AGENT_PREFER_CHAIN=base
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
